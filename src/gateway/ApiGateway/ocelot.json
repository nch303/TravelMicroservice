{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "authservice",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/api/auth/{everything}",
      "SwaggerKey": "auth"
    },
    {
      "DownstreamPathTemplate": "/api/user/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "userservice",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/api/user/{everything}",
      "SwaggerKey": "user"
    },
    {
      "DownstreamPathTemplate": "/api/schedule/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "scheduleservice",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/api/schedule/{everything}",
      "SwaggerKey": "schedule"
    },
    {
      "DownstreamPathTemplate": "/api/message/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "messageservice",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/api/message/{everything}",
      "SwaggerKey": "message"
    },
    {
      "DownstreamPathTemplate": "/api/advertisement/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "advertisementservice",
          "Port": 443
        }
      ],
      "UpstreamPathTemplate": "/api/advertisement/{everything}",
      "SwaggerKey": "advertisement"
    }
  ],
  "SwaggerEndPoints": [
    {
      "Key": "auth",
      "Config": [
        {
          "Name": "Auth Service",
          "Version": "v1",
          "Url": "https://authservice/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "user",
      "Config": [
        {
          "Name": "User Service",
          "Version": "v1",
          "Url": "https://userservice/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "schedule",
      "Config": [
        {
          "Name": "Schedule Service",
          "Version": "v1",
          "Url": "https://scheduleservice/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "message",
      "Config": [
        {
          "Name": "Message Service",
          "Version": "v1",
          "Url": "https://messageservice/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "advertisement",
      "Config": [
        {
          "Name": "Advertisement Service",
          "Version": "v1",
          "Url": "https://advertisementservice/swagger/v1/swagger.json"
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://apigateway:443"
  }
}

